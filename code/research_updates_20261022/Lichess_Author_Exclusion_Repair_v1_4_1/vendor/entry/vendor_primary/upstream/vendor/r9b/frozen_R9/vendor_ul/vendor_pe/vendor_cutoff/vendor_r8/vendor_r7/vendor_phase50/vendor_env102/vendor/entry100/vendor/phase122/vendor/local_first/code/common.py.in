def arrays(table): return {n:io.arr(table,n) for n in table.column_names}
def relocate(project, path):
    p=Path(path)
    if p.is_absolute():
        try: p=p.relative_to(BASE)
        except ValueError: raise RuntimeError('Recorded source is outside the project: '+str(p))
    return io.child(project,p)
def csvout(path, rows):
    path=Path(path); rows=io.clean(rows)
    names=list(dict.fromkeys(k for r in rows for k in r))
    with path.open('w',newline='') as f:
        w=csv.DictWriter(f,fieldnames=names);w.writeheader()
        for r in rows:
            w.writerow({k:json.dumps(v,sort_keys=True) if isinstance(v,(list,dict)) else v for k,v in r.items()})
def write_rows(root, name, rows):
    io.js(root/(name+'.json'), rows);csvout(root/(name+'.csv'), rows)
    # JSON is authoritative for nested design metadata; tabular Parquet is also available.
    flat=[{k:json.dumps(v,sort_keys=True) if isinstance(v,(list,dict)) else v for k,v in r.items()} for r in io.clean(rows)]
    if flat: io.table(root/(name+'.parquet'),pa.Table.from_pylist(flat))
def verify_package():
    p=ROOT/'PACKAGE_MANIFEST.sha256'
    for line in p.read_text().splitlines():
        digest,name=line.split('  ',1);io.checked(io.child(ROOT,name),digest)
    return io.sha(p)
def memory_gb():
    try: return os.sysconf('SC_PAGE_SIZE')*os.sysconf('SC_PHYS_PAGES')/1024**3
    except (ValueError,OSError):
        import subprocess
        return int(subprocess.check_output(['sysctl','-n','hw.memsize'],text=True))/1024**3
def defaults():
    memory=max(4,min(48,int(memory_gb()*.65)))
    workers=max(1,min(10,(os.cpu_count() or 2)-2,int((memory-2)//1.25)))
    return workers,memory
def pack_report(report, desktop, stem):
    desktop.mkdir(parents=True,exist_ok=True);dest=desktop/(stem+'.zip')
    tmp=dest.with_suffix('.zip.partial')
    with zipfile.ZipFile(tmp,'w',zipfile.ZIP_DEFLATED) as z:
        for p in sorted(report.iterdir()):
            if p.is_file():z.write(p,p.name)
    os.replace(tmp,dest);digest=io.sha(dest)
    Path(str(dest)+'.sha256').write_text(digest+'  '+dest.name+'\n')
    return str(dest)
