#!/bin/bash
set -euo pipefail
RD_RESUME_PACKAGE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
RD_RESUME_PROJECT="${MECHANISM_PROJECT_ROOT:-/Volumes/XT_Pro/lichess_kindness}"
RD_RESUME_DESKTOP="${MECHANISM_DESKTOP:-$HOME/Desktop/Lichess_Desktop}"
if [[ ! -d "$RD_RESUME_PROJECT" ]]; then
  echo "XT_Pro project directory not found: $RD_RESUME_PROJECT" >&2
  exit 1
fi
mkdir -p "$RD_RESUME_DESKTOP"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 NUMBA_NUM_THREADS=1
RD_RESUME_PY=""
shopt -s nullglob
RD_RESUME_CANDIDATES=("${MECHANISM_PYTHON:-}" "$RD_RESUME_PROJECT/venv/bin/python" "$RD_RESUME_PACKAGE/.venv/bin/python" "$RD_RESUME_DESKTOP"/*/.venv/bin/python)
for RD_RESUME_CANDIDATE in "${RD_RESUME_CANDIDATES[@]}"; do
  if [[ -x "$RD_RESUME_CANDIDATE" ]] && "$RD_RESUME_CANDIDATE" -c 'import sys,numpy,pandas,scipy,numba,duckdb,pyarrow,matplotlib; assert sys.version_info >= (3,10); assert tuple(map(int,duckdb.__version__.split(".")[:2])) == (1,5)' >/dev/null 2>&1; then
    RD_RESUME_PY="$RD_RESUME_CANDIDATE"
    break
  fi
done
if [[ -z "$RD_RESUME_PY" ]]; then
  echo "No compatible existing environment found. Creating an isolated environment inside this package."
  python3 -m venv "$RD_RESUME_PACKAGE/.venv"
  "$RD_RESUME_PACKAGE/.venv/bin/python" -m pip install -r "$RD_RESUME_PACKAGE/requirements.txt"
  RD_RESUME_PY="$RD_RESUME_PACKAGE/.venv/bin/python"
fi
"$RD_RESUME_PY" - "$RD_RESUME_PACKAGE" <<'PY'
import hashlib,sys,pathlib
p=pathlib.Path(sys.argv[1])
for line in (p/'PACKAGE_MANIFEST.sha256').read_text().splitlines():
    h,n=line.split('  ',1)
    if hashlib.sha256((p/n).read_bytes()).hexdigest()!=h:
        raise SystemExit('Package checksum mismatch: '+n)
print('PACKAGE_SHA256_OK')
PY
"$RD_RESUME_PY" -m unittest discover -s "$RD_RESUME_PACKAGE/tests" -p 'test_*.py' -q
RD_RESUME_LOG="$RD_RESUME_DESKTOP/MECHANISM_RD_RESUME_RUN_$(date -u +%Y%m%dT%H%M%SZ).log"
echo "Python: $RD_RESUME_PY"
echo "Log: $RD_RESUME_LOG"
echo "Targeted repair: one warm-started training fit; completed fits are preserved."
if [[ -x /usr/bin/caffeinate ]]; then
  /usr/bin/caffeinate -i "$RD_RESUME_PY" -u "$RD_RESUME_PACKAGE/code/run.py" --project-root "$RD_RESUME_PROJECT" --desktop "$RD_RESUME_DESKTOP" "$@" 2>&1 | tee "$RD_RESUME_LOG"
else
  "$RD_RESUME_PY" -u "$RD_RESUME_PACKAGE/code/run.py" --project-root "$RD_RESUME_PROJECT" --desktop "$RD_RESUME_DESKTOP" "$@" 2>&1 | tee "$RD_RESUME_LOG"
fi
