#!/bin/bash
set -euo pipefail
umask 077
task_bundle="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
task_project="${AUTHOR_EXCLUSION_PROJECT:-/Volumes/XT_Pro/lichess_kindness}"
task_transfer="${AUTHOR_EXCLUSION_TRANSFER:-$HOME/Desktop/Lichess_Desktop}"
cd "$task_bundle"
/usr/bin/shasum -a 256 -c PACKAGE_MANIFEST.sha256 >/dev/null
task_python=""
for task_candidate in "${AUTHOR_EXCLUSION_PYTHON:-/nonexistent}" "$task_project/venv/bin/python" "$task_project/.venv/bin/python" "${VIRTUAL_ENV:-/nonexistent}/bin/python" "$task_transfer/author_exclusion_python/bin/python" "$task_transfer"/author_exclusion_python.*/bin/python /opt/homebrew/bin/python3 "$(command -v python3 || true)"; do
  [[ -n "$task_candidate" && -x "$task_candidate" ]] || continue
  if "$task_candidate" -c 'import sys,numpy,pandas,duckdb,pyarrow,matplotlib; assert sys.version_info>=(3,10); assert tuple(map(int,numpy.__version__.split(".")[:2]))==(2,3); assert int(pandas.__version__.split(".")[0])==2' >/dev/null 2>&1; then
    task_python="$task_candidate"
    break
  fi
done
[[ -n "$task_python" ]] || { echo 'The Python environment used by v141 is required. Set AUTHOR_EXCLUSION_PYTHON to its bin/python path.' >&2; exit 1; }
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 MPLBACKEND=Agg
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1
mkdir -p "$task_transfer"
"$task_python" "$task_bundle/tests/test_prose143.py"
task_log="$task_transfer/AUTHOR_EXCLUSION_PROSE143_RUN_$(date +%Y%m%dT%H%M%S).log"
"$task_python" "$task_bundle/code/prose_checks.py" --project "$task_project" --result-dir "$task_transfer" --workers 10 --memory-gb 11 "$@" 2>&1 | tee "$task_log"
