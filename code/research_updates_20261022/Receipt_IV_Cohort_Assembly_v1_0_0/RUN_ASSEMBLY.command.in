#!/bin/bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
PROJECT="/Volumes/XT_Pro/lichess_kindness"
DESKTOP="$HOME/Desktop/Lichess_Desktop"
PYTHON="$PROJECT/venv/bin/python"
test -d "$PROJECT" || { echo "XT_Pro project is not mounted: $PROJECT" >&2; exit 1; }
test -d "$DESKTOP" || { echo "Missing destination: $DESKTOP" >&2; exit 1; }
test -x "$PYTHON" || { echo "Missing project Python: $PYTHON" >&2; exit 1; }
export PYTHONDONTWRITEBYTECODE=1
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
"$PYTHON" -c 'import duckdb, pyarrow, numpy; print("Dependencies:", duckdb.__version__, pyarrow.__version__, numpy.__version__)'
LOG="$DESKTOP/RECEIPT_IV_COHORT_ASSEMBLY_$(date -u +%Y%m%dT%H%M%SZ).log"
echo "Both __PRIVATE_VALUE_1__ and __PRIVATE_VALUE_2__ remain included. Author exclusion is deferred."
echo "Planning allowance: 4–12 hours for a first full run; the file pass prints a live ETA."
echo "The same command resumes completed checkpoints. Log: $LOG"
/usr/bin/caffeinate -dimsu "$PYTHON" "$HERE/code/run.py" \
  --project-root "$PROJECT" --desktop "$DESKTOP" --workers 10 --memory-gb 8 "$@" 2>&1 | tee "$LOG"
