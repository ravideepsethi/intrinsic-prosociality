#!/bin/bash
set -euo pipefail
MECH_PACKAGE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
MECH_PROJECT="${MECH_PROJECT_ROOT:-/Volumes/XT_Pro/lichess_kindness}"
MECH_DESKTOP="${MECH_DESKTOP_DIR:-$HOME/Desktop/Lichess_Desktop}"
if [[ ! -d "$MECH_PROJECT" ]]; then
  echo "Project directory not found: $MECH_PROJECT" >&2
  exit 1
fi
mkdir -p "$MECH_DESKTOP"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
MECH_PY=""
shopt -s nullglob
MECH_CANDIDATES=("${MECH_PYTHON:-}" "$MECH_PROJECT/venv/bin/python" "$MECH_PROJECT/.venv/bin/python" "$MECH_PACKAGE/.venv/bin/python" "$MECH_DESKTOP"/*/.venv/bin/python "$MECH_DESKTOP"/*/*/.venv/bin/python "$(command -v python3 || true)")
for MECH_CANDIDATE in "${MECH_CANDIDATES[@]}"; do
  if [[ -x "$MECH_CANDIDATE" ]] && "$MECH_CANDIDATE" -c 'import sys,numpy,pyarrow,duckdb; assert sys.version_info >= (3,10); assert (1,26)<=tuple(map(int,numpy.__version__.split(".")[:2]))<(3,0); assert 16<=int(pyarrow.__version__.split(".")[0])<26; assert tuple(map(int,duckdb.__version__.split(".")[:2]))==(1,5)' >/dev/null 2>&1; then
    MECH_PY="$MECH_CANDIDATE"
    break
  fi
done
if [[ -z "$MECH_PY" ]]; then
  python3 -c 'import sys; assert sys.version_info >= (3,10), "Use Python 3.10+ or set MECH_PYTHON to an existing compatible environment"'
  echo "Creating an isolated Python environment for this package."
  python3 -m venv "$MECH_PACKAGE/.venv"
  "$MECH_PACKAGE/.venv/bin/python" -m pip install -r "$MECH_PACKAGE/requirements.txt"
  MECH_PY="$MECH_PACKAGE/.venv/bin/python"
fi
"$MECH_PY" -c 'import sys; assert sys.version_info >= (3,10), "Python 3.10 or newer is required"'
"$MECH_PY" -c 'import sys; sys.path.insert(0,sys.argv[1]); from common import verify_package; verify_package()' "$MECH_PACKAGE/code"
"$MECH_PY" -m unittest discover -s "$MECH_PACKAGE/tests" -p 'test_*.py' -q
MECH_LOG="$MECH_DESKTOP/RECEIPT_MECHANISMS_RUN_$(date -u +%Y%m%dT%H%M%SZ).log"
echo "Log: $MECH_LOG"
echo "Existing local data only. Checkpointed stages resume after interruption."
if [[ -x /usr/bin/caffeinate ]]; then
  /usr/bin/caffeinate -i "$MECH_PY" -u "$MECH_PACKAGE/code/run.py" --project-root "$MECH_PROJECT" --desktop "$MECH_DESKTOP" "$@" 2>&1 | tee "$MECH_LOG"
else
  "$MECH_PY" -u "$MECH_PACKAGE/code/run.py" --project-root "$MECH_PROJECT" --desktop "$MECH_DESKTOP" "$@" 2>&1 | tee "$MECH_LOG"
fi
