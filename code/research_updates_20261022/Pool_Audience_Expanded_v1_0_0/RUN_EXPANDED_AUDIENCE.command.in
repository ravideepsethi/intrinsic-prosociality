#!/bin/bash
set -euo pipefail

task_code="$(cd "$(dirname "$0")" && pwd)"
task_desktop="$HOME/Desktop/Lichess_Desktop"
task_project="${LICHESS_AUDIENCE_PROJECT_ROOT:-/Volumes/XT_Pro/lichess_kindness}"
task_python="${LICHESS_AUDIENCE_PYTHON:-python3}"
task_threads="${LICHESS_AUDIENCE_THREADS:-10}"
task_memory="${LICHESS_AUDIENCE_MEMORY_GB:-6}"
task_env="$task_desktop/audience_expanded_v100_env"
mkdir -p "$task_desktop"

if [[ ! -d "$task_project/derived/replication/analysis_panel_pool_nonadjacent_24m_v100_PRIVATE/panel" ]]; then
  echo "Current main panel not found under $task_project. Mount XT_Pro first."
  exit 1
fi
cd "$task_code"
/usr/bin/shasum -a 256 -c PACKAGE_MANIFEST.sha256
"$task_python" -c 'import sys; assert sys.version_info >= (3,11), "Python 3.11 or newer is required"'
if [[ ! -x "$task_env/bin/python" ]]; then
  "$task_python" -m venv "$task_env"
fi
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 PYTHONUNBUFFERED=1
"$task_env/bin/python" -m pip install --disable-pip-version-check -r "$task_code/requirements.txt"
"$task_env/bin/python" "$task_code/self_test.py"

task_stamp="$(date -u +%Y%m%dT%H%M%SZ)_$$"
task_out="$task_project/output/POOL_AUDIENCE_EXPANDED_RESULTS_v100_$task_stamp"
task_log="$task_desktop/POOL_AUDIENCE_EXPANDED_v100_$task_stamp.log"
task_args=(--project-root "$task_project" --out "$task_out" --threads "$task_threads" --memory-gb "$task_memory")
if [[ -f "$task_desktop/known_streamers_extra.csv" ]]; then
  task_args+=(--extra-streamers "$task_desktop/known_streamers_extra.csv")
fi
echo "Log: $task_log"
"$task_env/bin/python" -u "$task_code/run_expanded.py" "${task_args[@]}" 2>&1 | tee "$task_log"
test -f "$task_out/_SUCCESS.json"
cp "$task_out.zip" "$task_desktop/"
cp "$task_out.zip.sha256" "$task_desktop/"
cd "$task_desktop"
/usr/bin/shasum -a 256 -c "$(basename "$task_out.zip.sha256")"
echo "Upload these two files:"
echo "$task_desktop/$(basename "$task_out.zip")"
echo "$task_desktop/$(basename "$task_out.zip.sha256")"
