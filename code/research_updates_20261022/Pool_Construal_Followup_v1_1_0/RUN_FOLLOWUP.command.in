#!/bin/bash
set -euo pipefail
task_package="$(cd "$(dirname "$0")" && pwd)"
task_desktop="${LICHESS_TRANSFER_ROOT:-$HOME/Desktop/Lichess_Desktop}"
task_project="${LICHESS_PROJECT_ROOT:-/Volumes/XT_Pro/lichess_kindness}"
mkdir -p "$task_desktop"
(cd "$task_package" && /usr/bin/shasum -a 256 -c PACKAGE_MANIFEST.sha256)
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 NUMBA_NUM_THREADS=1 PYTHONUNBUFFERED=1
task_check='import sys,numpy,scipy,pandas,pyarrow,duckdb,numba; v=lambda m:tuple(map(int,m.__version__.split(".")[:2])); assert sys.version_info>=(3,10); assert duckdb.__version__=="1.5.2"; assert (1,26)<=v(numpy)<(2,4); assert (1,11)<=v(scipy)<(2,0); assert (2,0)<=v(pandas)<(4,0); assert (17,0)<=v(pyarrow)<(26,0); assert (0,63,1)<=tuple(map(int,numba.__version__.split(".")[:3]))<(0,68,0)'
task_python="${LICHESS_CONSTRUAL_PYTHON:-}"
task_base="$(command -v python3 || true)"
if [ -n "$task_python" ]; then
  "$task_python" -c "$task_check"
else
  task_old_env="$task_desktop/construal_tests_python_v100"
  task_env="$task_desktop/construal_followup_python_v110"
  if [ -x "$task_old_env/bin/python" ] && "$task_old_env/bin/python" -c "$task_check" >/dev/null 2>&1; then
    task_python="$task_old_env/bin/python"
  elif [ -x "$task_env/bin/python" ] && "$task_env/bin/python" -c "$task_check" >/dev/null 2>&1; then
    task_python="$task_env/bin/python"
  elif [ -n "$task_base" ] && "$task_base" -c "$task_check" >/dev/null 2>&1; then
    task_python="$task_base"
  else
    if [ -z "$task_base" ]; then echo 'Python 3.10+ is required. Open your usual Python/conda Terminal.'; exit 2; fi
    "$task_base" -m venv "$task_env"
    "$task_env/bin/python" -m pip install --upgrade pip
    "$task_env/bin/python" -m pip install -r "$task_package/requirements.txt"
    task_python="$task_env/bin/python"
    "$task_python" -c "$task_check"
  fi
fi
cd "$task_package"
"$task_python" test_followup.py
"$task_python" run_followup.py \
  --project-root "$task_project" \
  --desktop "$task_desktop" \
  --workers "${LICHESS_CONSTRUAL_WORKERS:-2}" \
  --hash-workers "${LICHESS_CONSTRUAL_HASH_WORKERS:-1}" \
  --memory "${LICHESS_CONSTRUAL_MEMORY:-4GB}" \
  "$@"
