#!/bin/bash
set -euo pipefail
umask 077
iv_mode="${1:?Specify run3, run2, status, or tests}"
shift
iv_package="$(cd "$(dirname "$0")" && pwd -P)"
iv_project="${IV_PROJECT_ROOT:-/Volumes/XT_Pro/lichess_kindness}"
iv_desktop="${IV_DESKTOP:-$HOME/Desktop/Lichess_Desktop}"
mkdir -p "$iv_desktop"
export PYTHONDONTWRITEBYTECODE=1
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
export TMPDIR="$(cd "${TMPDIR:-/tmp}" && pwd -P)"
iv_python="${IV_PYTHON:-$iv_project/venv/bin/python}"
if [[ ! -x "$iv_python" ]]; then
  echo "The project Python was not found: $iv_python"
  echo 'Connect XT_Pro, or set IV_PYTHON to the existing research Python. No environment has been changed.'
  exit 2
fi
"$iv_python" - <<'PY'
import sys
assert sys.version_info >= (3,10), 'Python 3.10 or later is required'
import numpy, pyarrow, duckdb
print('Python',sys.version.split()[0],'; NumPy',numpy.__version__,'; PyArrow',pyarrow.__version__,'; DuckDB',duckdb.__version__,'; SciPy not required',flush=True)
PY
cd "$iv_package"
"$iv_python" - <<'PY'
import sys
sys.path.insert(0,'code')
from common import verify_package
verify_package()
print('PACKAGE_SHA256_OK',flush=True)
PY
iv_log="$iv_desktop/iv_priority_${iv_mode}_$(date -u +%Y%m%dT%H%M%SZ)_$$.log"
echo "Log: $iv_log"
iv_awake=()
if [[ -x /usr/bin/caffeinate ]]; then iv_awake=(/usr/bin/caffeinate -i); fi
set +e
{
  case "$iv_mode" in
    run3)
      echo 'Expected runtime: about 1–3 hours for the first author-clean run; unbenchmarked laptop estimate. Cache reuse shortens reruns.'
      "$iv_python" -m unittest discover -s tests -p 'test_*.py' -q || exit "$?"
      "${iv_awake[@]}" "$iv_python" -u code/run_leniency.py --project-root "$iv_project" --desktop "$iv_desktop" "$@"
      ;;
    run2)
      echo 'Expected runtime: live checkpoint ETA; about 23 days if all 57.1M original metadata targets remain. One API request at a time.'
      (cd comparison_original && "$iv_python" -m unittest -q test_expansion) || exit "$?"
      "${iv_awake[@]}" "$iv_python" -u code/run_comparison.py download --project-root "$iv_project" --desktop "$iv_desktop" "$@"
      ;;
    status)
      echo 'Expected runtime: usually under 30 seconds; read-only checkpoint status.'
      "$iv_python" -u code/run_comparison.py status --project-root "$iv_project" --desktop "$iv_desktop" "$@"
      ;;
    tests)
      echo 'Expected runtime: roughly 5–30 seconds. Synthetic/local tests; no API requests.'
      "$iv_python" -m unittest discover -s tests -p 'test_*.py' -v || exit "$?"
      (cd comparison_original && "$iv_python" -m unittest -v test_expansion)
      ;;
    *) echo 'Unknown mode'; exit 2;;
  esac
} 2>&1 | tee "$iv_log"
iv_exit=${PIPESTATUS[0]}
set -e
if [[ "$iv_exit" -ne 0 ]]; then
  echo "Stopped with exit $iv_exit. Keep the log: $iv_log. Completed checkpoints remain available."
fi
exit "$iv_exit"
