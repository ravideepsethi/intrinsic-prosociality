#!/bin/bash
set -euo pipefail
task_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
task_python=""
for task_candidate in python3.12 python3.13 python3.11 python3; do
    if command -v "$task_candidate" >/dev/null 2>&1 && \
       "$task_candidate" -c 'import sys; sys.exit(0 if (3,11) <= sys.version_info[:2] <= (3,13) else 1)' 2>/dev/null; then
        task_python="$(command -v "$task_candidate")"
        break
    fi
done
if [ -z "$task_python" ]; then
    printf '%s\n' 'Python 3.11–3.13 is required.' >&2
    exit 1
fi
task_env="$task_dir/.venv"
if [ ! -e "$task_env" ]; then
    "$task_python" -m venv "$task_env"
elif [ ! -x "$task_env/bin/python" ]; then
    printf '%s\n' 'Existing environment is incomplete; use a fresh extraction.' >&2
    exit 1
fi
"$task_env/bin/python" -m pip --disable-pip-version-check install -r "$task_dir/requirements.txt"
"$task_env/bin/python" "$task_dir/code/make_desert_ply.py"
printf '\nFigures: %s\n' "$task_dir/figures"
