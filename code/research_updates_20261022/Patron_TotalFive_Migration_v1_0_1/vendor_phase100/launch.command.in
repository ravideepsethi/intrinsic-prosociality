#!/bin/bash
set -euo pipefail
umask 077
r2_mode="${1:?Expected analyze or tests}"; shift
r2_package="$(cd "$(dirname "$0")" && pwd -P)"
r2_project="${IV_PROJECT_ROOT:-/Volumes/XT_Pro/lichess_kindness}"
r2_desktop="${IV_DESKTOP:-$HOME/Desktop/Lichess_Desktop}"
r2_python="${IV_PYTHON:-$r2_project/venv/bin/python}"
if [[ ! -x "$r2_python" ]]; then echo "Research Python unavailable: $r2_python. Connect XT_Pro or set IV_PYTHON."; exit 2; fi
if [[ "$r2_mode" != analyze && "$r2_mode" != tests ]]; then echo 'Use RUN_FINAL_100.command or RUN_TESTS.command'; exit 2; fi
mkdir -p "$r2_desktop"
export PYTHONDONTWRITEBYTECODE=1
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
cd "$r2_package"
"$r2_python" - <<'PY'
import sys,numpy,pyarrow,duckdb
assert sys.version_info>=(3,11)
sys.path.insert(0,'code')
from release100 import verify_release
verify_release()
print('PACKAGE_SHA256_OK; Python',sys.version.split()[0],'; NumPy',numpy.__version__,'; PyArrow',pyarrow.__version__,'; DuckDB',duckdb.__version__,'; SciPy not required',flush=True)
PY
r2_log="$r2_desktop/run2_phase100_final_${r2_mode}_$(date -u +%Y%m%dT%H%M%SZ)_$$.log"
r2_awake=()
if [[ -x /usr/bin/caffeinate ]]; then r2_awake=(/usr/bin/caffeinate -i); fi
echo "Log: $r2_log"
set +e
{
  echo 'Expected runtime: 1–3 minutes for offline tests; about 3–6 hours for the first full analysis. This is a planning estimate from earlier runs, not a measured 100% benchmark. SSD throughput and missing history keys can add time.'
  echo 'Zero API requests. Reuses 75% Parquet features and certified R9 ENV rates; source checks and exact row/score bridges precede new estimates.'
  echo 'Up to 10 workers within 11 GiB. Large fits run one at a time; small scans run concurrently. ENV uses the tested 3 GB two-worker plan with selective 8 GB serial retry.'
  echo 'Current certified Score A; ENV-indicator primary, X0 companion. Receipt IV is reused. Fits 100% and added 75–100% comparisons, with joint account/date covariance.'
  r2_tests="${r2_log%.log}_selftests.log"
  echo "Offline self-tests: $r2_tests"
  if "$r2_python" -u code/test_runner.py > "$r2_tests" 2>&1; then
    echo 'OFFLINE_SELF_TESTS_OK'
  else
    r2_test_exit=$?; cat "$r2_tests"; exit "$r2_test_exit"
  fi
  if [[ "$r2_mode" == analyze ]]; then
    "${r2_awake[@]}" "$r2_python" -u code/run_final.py --project-root "$r2_project" --desktop "$r2_desktop" "$@"
  fi
} 2>&1 | tee "$r2_log"
r2_exit=${PIPESTATUS[0]}
set -e
if [[ "$r2_exit" -ne 0 ]]; then echo "Stopped with exit $r2_exit. Completed Parquets remain reusable. Return this log: $r2_log"; fi
exit "$r2_exit"
