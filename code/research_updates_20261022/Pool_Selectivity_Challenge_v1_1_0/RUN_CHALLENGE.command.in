#!/bin/bash
set -euo pipefail
task_package="$(cd "$(dirname "$0")" && pwd)"
task_desktop="${LICHESS_TRANSFER_ROOT:-$HOME/Desktop/Lichess_Desktop}"
task_project="${LICHESS_PROJECT_ROOT:-/Volumes/XT_Pro/lichess_kindness}"
mkdir -p "$task_desktop"
(cd "$task_package" && /usr/bin/shasum -a 256 -c PACKAGE_MANIFEST.sha256)
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1 PYTHONUNBUFFERED=1
task_python="${LICHESS_STRUCTURAL_PYTHON:-}"
task_check='import sys,numpy,scipy,pandas,pyarrow,duckdb; assert sys.version_info>=(3,10); assert duckdb.__version__=="1.5.2"; assert (1,26)<=tuple(map(int,numpy.__version__.split(".")[:2]))<(3,0); assert (1,11)<=tuple(map(int,scipy.__version__.split(".")[:2]))<(2,0); assert 17<=int(pyarrow.__version__.split(".")[0])<26; assert 2<=int(pandas.__version__.split(".")[0])<4'
task_base="$(command -v python3 || true)"
if [ -n "$task_python" ]; then
  "$task_python" -c "$task_check"
else
  task_env="$task_desktop/selectivity_pilot_python_v100"
  if [ -x "$task_env/bin/python" ] && "$task_env/bin/python" -c "$task_check" >/dev/null 2>&1; then
    task_python="$task_env/bin/python"
  elif [ -n "$task_base" ] && "$task_base" -c "$task_check" >/dev/null 2>&1; then
    task_python="$task_base"
  else
    if [ -z "$task_base" ]; then echo 'Python 3.10+ is required; use your usual Python/conda Terminal.'; exit 1; fi
    "$task_base" -c 'import sys; assert sys.version_info >= (3,10), "Python 3.10+ required"'
    if [ ! -x "$task_env/bin/python" ]; then "$task_base" -m venv "$task_env"; fi
    "$task_env/bin/python" -m pip install -r "$task_package/requirements.txt"
    task_python="$task_env/bin/python"
  fi
fi
task_log="$task_desktop/pool_selectivity_challenge_v110_$(date -u +%Y%m%dT%H%M%SZ)_$$.log"
echo "Log: $task_log"
"$task_python" "$task_package/self_test.py" 2>&1 | tee "$task_log"
"$task_python" "$task_package/challenge.py" \
  --project-root "$task_project" --transfer-root "$task_desktop" \
  --workers "${LICHESS_STRUCTURAL_WORKERS:-2}" "$@" 2>&1 | tee -a "$task_log"
