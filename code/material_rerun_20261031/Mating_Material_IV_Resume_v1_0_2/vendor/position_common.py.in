def save(path, value):
    path=Path(path);path.parent.mkdir(parents=True,exist_ok=True)
    tmp=path.with_name(path.name+'.tmp')
    tmp.write_text(json.dumps(value,indent=2,sort_keys=True,allow_nan=False,default=lambda x: x.item() if isinstance(x,np.generic) else str(x))+'\n')
    os.replace(tmp,path)

def table(path,rows):
    path=Path(path);path.parent.mkdir(parents=True,exist_ok=True)
    if not rows: return
    fields=list(dict.fromkeys(k for r in rows for k in r))
    with path.open('w',newline='') as f:
        w=csv.DictWriter(f,fieldnames=fields);w.writeheader();w.writerows(rows)

def stage(root, conf, build, deps=()):
    # Include input content in the key, not only file metadata. Parent stages are read-only.
    root=Path(root); deps=list(map(Path,deps))
    identity=c.key([conf,[(str(p.resolve()),sha(p)) for p in deps]])
    receipt=root/'POSITION_DONE.json'
    if receipt.exists():
        r=load(receipt);require(r['identity']==identity,'Stage inputs changed: '+str(root))
        for rec in r['files']:cert.checked_file(root/rec['path'],rec)
        log('REUSE '+root.name);return root
    tmp=root.with_name(root.name+'.partial')
    if tmp.exists(): shutil.rmtree(tmp)
    tmp.mkdir(parents=True);started=time.monotonic()
    with cert.heartbeat(root.name): meta=build(tmp) or {}
    require(identity==c.key([conf,[(str(p.resolve()),sha(p)) for p in deps]]),'Stage input changed during computation')
    # Scratch/spill is not evidence and must not enter receipts or public reports.
    for p in tmp.rglob('spill'):
        if p.is_dir():shutil.rmtree(p)
    files=[dict(path=str(p.relative_to(tmp)),bytes=p.stat().st_size,sha256=sha(p))
           for p in sorted(tmp.rglob('*')) if p.is_file()]
    save(tmp/'POSITION_DONE.json',dict(identity=identity,files=files,meta=meta,seconds=time.monotonic()-started))
    if root.exists():raise RuntimeError('Unsealed stage exists: '+str(root))
    os.replace(tmp,root);return root

def sql(root,memory=3.):return c.conn(root,memory)
def view(con,name,path):c.view(con,name,path)
def copy(con,query,path):c.copy_query(con,query,path)
def col(path,name):return pq.read_table(path,columns=[name]).column(0).to_numpy(zero_copy_only=False)
def inference(beta,var,scale=1.):return model.inference90(float(beta),float(var),scale)

def checkpoint(run,result_dir,percent,extra=None):
    save(run/'report/STATUS.json',dict(milestone=percent,complete=percent==100,
        milestone_is_not_elapsed_time_percent=True,**(extra or {})))
    records=[dict(path=str(p.relative_to(run/'report')),bytes=p.stat().st_size,sha256=sha(p))
             for p in sorted((run/'report').rglob('*')) if p.is_file() and p.name!='REPORT_MANIFEST.json']
    save(run/'report/REPORT_MANIFEST.json',records)
    dest=Path(result_dir)/f'RECEIPT_POSITION_{run.name}_{percent:03}.zip';tmp=dest.with_suffix('.partial')
    with zipfile.ZipFile(tmp,'w',zipfile.ZIP_DEFLATED) as z:
        for p in sorted((run/'report').rglob('*')):
            if p.is_file():z.write(p,'report/'+str(p.relative_to(run/'report')))
    os.replace(tmp,dest);dest.with_suffix(dest.suffix+'.sha256').write_text(sha(dest)+'  '+dest.name+'\n')
    log('CHECKPOINT '+str(dest));return dest

def covariance(path,columns,root):
    # Explicit bounded implementation avoids an optimistic RAM decision for wide joint fits.
    from fast_covariance import covariance as cov
    n=pq.ParquetFile(path).metadata.num_rows
    buckets=min(128,max(8,2**int(np.ceil(np.log2(max(1,n/1000000))))))
    return cov(path,columns,root,memory=3.,buckets=buckets)
