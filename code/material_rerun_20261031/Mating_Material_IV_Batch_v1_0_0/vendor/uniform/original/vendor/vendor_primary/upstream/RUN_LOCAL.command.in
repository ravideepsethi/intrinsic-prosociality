#!/bin/bash
set -euo pipefail
TASK_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd -- "$TASK_DIR"
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,11) else "Python 3.11 or newer is required")'
if [ ! -x .venv/bin/python ]; then
  python3 -m venv .venv
fi
if [ ! -f .venv/.r12r13_ready ]; then
  .venv/bin/python -m pip install --upgrade pip
  .venv/bin/python -m pip install -r requirements.txt
  touch .venv/.r12r13_ready
fi
if command -v caffeinate >/dev/null 2>&1; then
  exec caffeinate -dimsu .venv/bin/python run_local.py "$@"
else
  exec .venv/bin/python run_local.py "$@"
fi
