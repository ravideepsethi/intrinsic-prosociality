"""Read-only authenticated inputs and atomic, private checkpoints."""
from __future__ import annotations
import contextlib, datetime as dt, hashlib, json, math, os, threading, time, uuid
from pathlib import Path
import duckdb
import pyarrow.parquet as pq

ROOT = Path(__file__).resolve().parents[1]
VERSION = '1.0.0'
AUTHORS = ('__PRIVATE_VALUE_1__', '__PRIVATE_VALUE_2__')
MONTHS = [f'{y}-{m:02}' for y in (2023, 2024, 2025) for m in range(1, 13)
          if '2023-11' <= f'{y}-{m:02}' <= '2025-10']
PIECES = [('pawns', 'p', 1), ('knights', 'n', 3), ('bishops', 'b', 3),
          ('rooks', 'r', 5), ('queens', 'q', 9)]
ORIGINAL_REPORT = '917aa14ed8a8dbb7e82f9af1424aae079797edf4b1b06a4c27de084aca102c57'

def require(ok, message):
    if not ok: raise RuntimeError(message)

def log(message):
    print(dt.datetime.now(dt.timezone.utc).strftime('[%Y-%m-%d %H:%M:%SZ] ') + str(message), flush=True)

def read(path): return json.loads(Path(path).read_text())

def clean(x):
    if isinstance(x, dict): return {str(k): clean(v) for k, v in x.items()}
    if isinstance(x, (tuple, list)): return [clean(v) for v in x]
    if isinstance(x, Path): return str(x)
    if isinstance(x, float) and not math.isfinite(x): return None
    return x

def write(path, data):
    p = Path(path); p.parent.mkdir(parents=True, exist_ok=True)
    t = p.with_name(p.name + '.partial_' + uuid.uuid4().hex)
    t.write_text(json.dumps(clean(data), sort_keys=True, indent=2, allow_nan=False) + '\n')
    os.replace(t, p)

def digest(x): return hashlib.sha256(json.dumps(clean(x), sort_keys=True, separators=(',', ':')).encode()).hexdigest()

def stamp(path):
    p = Path(path).resolve(); s = p.stat()
    return [str(p), s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns]

def sha(path):
    before = stamp(path); h = hashlib.sha256()
    with Path(path).open('rb') as f:
        for b in iter(lambda: f.read(8 * 1024**2), b''): h.update(b)
    require(stamp(path) == before, 'File changed while hashing: ' + Path(path).name)
    return h.hexdigest()

def record(path):
    return dict(path=str(Path(path).resolve()), bytes=Path(path).stat().st_size, sha256=sha(path))

def verify(r):
    p = Path(r['path'])
    require(p.is_file() and p.stat().st_size == r['bytes'] and sha(p) == r['sha256'],
            'Changed checkpoint: ' + p.name)
    return p

def q(x): return "'" + str(x).replace("'", "''") + "'"
def ident(x): return '"' + str(x).replace('"', '""') + '"'
def scan(paths):
    if isinstance(paths, (str, Path)): paths = [paths]
    require(bool(paths), 'Empty Parquet source')
    return 'read_parquet([' + ','.join(q(p) for p in paths) + '], hive_partitioning=false)'

def db(temp, memory, threads=1):
    Path(temp).mkdir(parents=True, exist_ok=True)
    c = duckdb.connect(config={'threads': str(threads), 'memory_limit': f'{memory:.3f}GB',
                              'temp_directory': str(temp)})
    c.execute('SET preserve_insertion_order=false')
    c.execute("SET TimeZone='UTC'")
    return c

def copy(c, query, path):
    p = Path(path); p.parent.mkdir(parents=True, exist_ok=True)
    t = p.with_name(p.name + '.partial')
    n = c.execute('COPY (' + query + ') TO ' + q(t) +
                  ' (FORMAT PARQUET, COMPRESSION ZSTD, ROW_GROUP_SIZE 65536)').fetchone()[0]
    os.replace(t, p); return int(n)

def csv_query(c, query, path):
    p = Path(path); t = p.with_name(p.name + '.partial')
    c.execute('COPY (' + query + ') TO ' + q(t) + ' (FORMAT CSV, HEADER true)')
    os.replace(t, p)

@contextlib.contextmanager
def heartbeat(label):
    stop = threading.Event(); start = time.monotonic()
    def pulse():
        while not stop.wait(30): log(f'{label}; elapsed {(time.monotonic()-start)/60:.1f} min')
    thread = threading.Thread(target=pulse, daemon=True); thread.start()
    try: yield
    finally: stop.set(); thread.join()
